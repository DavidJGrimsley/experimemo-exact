                      column gap=8
                        text "Before you begin" role="heading" aria-level=2 font-size="1.75rem" font-weight=800 line-height=1.4 -exact-fit="shrink"
                        text "Review the privacy policy and terms of service, then continue once both are accepted." font-size="0.9375rem" line-height="1.375rem"
                      column background-color="surface.card" border="1px solid var(--brand)" border-radius=12 padding=16 gap=10
                        text "Privacy policy" font-size="1.0625rem" font-weight=800
                        text "Read how Experimemo handles local experiment data, attached photos, and support requests." font-size="0.875rem" line-height="1.25rem"
                        row gap=12 flex-wrap="wrap" align-items="center" justify-content="space-between"
                          button press=openPrivacy testId="open-privacy" aria-label="Open policy" border="1px solid var(--brand)" border-radius=999 min-height="3rem" padding="0.5rem 1rem" font-weight=800 font-size="0.875rem"
                            text "Open policy" -exact-fit="shrink"
                          row gap=8 flex-wrap="wrap" align-items="center" min-width=0
                            text "Accepted" font-size="0.875rem" font-weight=700
                            input type="checkbox" switch checked=acceptedPrivacy change=setPrivacy aria-label="Accept privacy policy" testId="accept-privacy"
                      column background-color="surface.card" border="1px solid var(--brand)" border-radius=12 padding=16 gap=10
                        text "Terms of service" font-size="1.0625rem" font-weight=800
                        text "Review the live terms before you start saving and updating experiment records." font-size="0.875rem" line-height="1.25rem"
                        row gap=12 flex-wrap="wrap" align-items="center" justify-content="space-between"
                          button press=openTerms testId="open-terms" aria-label="Open terms" border="1px solid var(--brand)" border-radius=999 min-height="3rem" padding="0.5rem 1rem" font-weight=800 font-size="0.875rem"
                            text "Open terms" -exact-fit="shrink"
                          row gap=8 flex-wrap="wrap" align-items="center" min-width=0
                            text "Accepted" font-size="0.875rem" font-weight=700
                            input type="checkbox" switch checked=acceptedTerms change=setTerms aria-label="Accept terms of service" testId="accept-terms"
                      if acceptedPrivacy and acceptedTerms
                        link href="/onboarding/account-setup" testId="continue" background-color="brand" color="ink.on-brand" border-radius=12 min-height="3rem" padding="0.75rem 1rem" font-weight=800 align-self="flex-start" max-width="100%" box-sizing="border-box"
                          text "Continue"
                      else
                        button testId="continue-disabled" aria-label="Continue" aria-disabled=true background-color="surface.card" border-radius=12 min-height="3rem" padding="0.75rem 1rem" opacity=0.7 align-self="flex-start"
                          text "Continue" font-weight=800
                else if e.name == "ready"
                  header
                    text "Account Setup" role="heading" aria-level=1 -exact-fit="shrink"
                  scroll id=`content-${e.id}` flex=1 min-height=0
                    column padding=20 gap=14 max-width="45rem" margin="0 auto" width="100%" box-sizing="border-box"
                      text "You are ready to start" role="heading" aria-level=2 font-size="1.75rem" font-weight=800 line-height=1.4 -exact-fit="shrink"
                      text "Head back into the app to begin creating and tracking your experiments." font-size="0.9375rem" line-height="1.375rem"
                      column background-color="surface.card" border="1px solid var(--brand)" border-radius=12 padding=16 gap=10
                        text "Next step" font-size="1.0625rem" font-weight=800
                        text "Create a new experiment or open Track to keep working on something you already saved." font-size="0.875rem" line-height="1.25rem"
                      link href="/" testId="open-experiments" background-color="brand" color="ink.on-brand" border-radius=12 min-height="3rem" padding="0.75rem 1rem" font-weight=800 align-self="flex-start" max-width="100%" box-sizing="border-box"
                        text "Open experiments" -exact-fit="shrink"
                else if e.name == "experiment"
                  header
                    button id="back" press=done aria-label="Back to Track" testId="editor-back"
                      text "Track"
                    text (match first(experiments.filter(x => x.id == e.params.id)) { case some(x) => x.title, case none => (pending(experiments) ? "Loading…" : "Not found") }) role="heading" aria-level=1 testId="editor-title" white-space="nowrap" text-overflow="ellipsis" overflow="hidden"
                  if pending(experiments)
                    column padding=20 testId="editor-loading"
                      text "Loading experiment…" font-size="0.9375rem"
                  else if failed(experiments)
                    column padding=20 gap=12 testId="editor-failed"
                      text "This experiment could not be read from storage." font-size="0.9375rem" font-weight=800
                      text loadError font-size="0.8125rem" line-height="1.25rem" testId="editor-failed-detail"
                      button press=reload testId="editor-retry" border="1px solid var(--brand)" border-radius=999 min-height="3rem" padding="0.5rem 1rem" align-self="flex-start"
                        text "Try again" font-weight=800 font-size="0.875rem"
                  else if experiments.filter(x => x.id == e.params.id).length == 0
                    column padding=20 gap=12 testId="editor-missing"
                      text "This experiment does not exist" font-size="1.75rem" font-weight=800 line-height=1.4 -exact-fit="shrink"
                      text "It may have been deleted. Head back to Track to see your experiments." font-size="0.9375rem" line-height="1.375rem"
                      link href="/track" testId="editor-missing-track" background-color="brand" color="ink.on-brand" border-radius=12 min-height="3rem" padding="0.75rem 1rem" font-weight=800 align-self="flex-start" max-width="100%" box-sizing="border-box"
                        text "Back to Track"
                  else
                    for x in experiments.filter(r => r.id == e.params.id) key=x.id
                      ExperimentEditor(route=e.id, x=x, fieldDrafts=fieldDrafts, touch=touch, retry=retrySave, setStatus=changeStatus, saveError=savedError, savedId=savedId, draft=(match first(noteDrafts.filter(d => d.expId == x.id)) { case some(d) => d.notes, case none => "" }), editDraft=editDraft, addResult=addResult, adding=pending(resultAdded), addError=addError, editResult=editResultDraft, retryResult=retryResult, resultDrafts=resultDrafts, askDeleteResult=askDeleteResult, removeResultError=removeResultError, resultBusy=pending(resultEdited) or pending(resultRemoved), draftPhotos=draftPhotoSets.filter(d => d.owner == x.id).map(d => d.photo), askPhotos=askPhotos, removePhoto=removePhotoFrom, photoNote=photoNote, photoNoteKey=photoNoteKey, photoBusy=photoBusy, hasPending=hasPending, saving=pending(saved), statusBusy=pending(statusSaved), statusError=statusError)
                else if e.name == "track"
                  scroll id=`content-${e.id}` flex=1 min-height=0
                    column padding=20 gap=20 width="100%" box-sizing="border-box"
                      header appearance="none" display="flex" flex-direction="column" gap=8
                        row width="100%" align-items="center" flex-wrap="wrap" gap=12
                          text "Track experiments" role="heading" aria-level=1 font-size="1.75rem" font-weight=800 line-height=1.4 flex=(wide ? "1 1 0" : "1 1 12rem") min-width=0 -exact-fit="shrink"
                          TopTabs(wide=wide, current="track", goNew=pickNew, goTrack=pickTrack)
                          row flex=(wide ? "1 1 0" : "0 0 auto") justify-content="flex-end"
                            link href="/info" aria-label="Open app info and settings" testId="info-track" min-width="2.5rem" min-height="2.5rem" padding="0.5rem" flex-shrink=0 border="1px solid var(--brand)" border-radius=999 background-color="surface.card" display="flex" align-items="center" justify-content="center"
                              image "symbol:info" font-size="1.375rem"
                        text "Review every experiment in one place and reopen any record to keep adding observations, notes, and photos." font-size="0.9375rem" line-height="1.375rem"
                      if pending(experiments)
                        text "Loading experiments…" font-size="0.9375rem" testId="track-loading" role="status"
                      else if failed(experiments)
                        column background-color="surface.card" border="1px solid var(--warning)" border-radius=12 padding=16 gap=10 testId="track-failed"
                          text "Experiments could not be read" font-size="1.0625rem" font-weight=800
                          text loadError font-size="0.875rem" line-height="1.25rem" testId="track-failed-detail"
                          button press=reload testId="track-retry" border="1px solid var(--brand)" border-radius=999 min-height="3rem" padding="0.5rem 1rem" align-self="flex-start"
                            text "Try again" font-weight=800 font-size="0.875rem"
                      else if experiments.length == 0
                        column background-color="surface.card" border="1px solid var(--brand)" border-radius=12 padding=16 gap=10 testId="track-empty"
                          text "No experiments yet" font-size="1.0625rem" font-weight=800 -exact-fit="shrink"
                          text "Create your first experiment to start recording your process and results." font-size="0.875rem" line-height="1.25rem"
                          button press=pickNew testId="create-experiment" background-color="brand" color="ink.on-brand" border-radius=999 min-height="3rem" padding="0.5rem 1rem" align-self="flex-start" max-width="100%" box-sizing="border-box"
                            text "Create experiment" font-weight=800 font-size="0.875rem" -exact-fit="shrink"
                      else
                        if experiments.filter(x => not x.complete).length > 0
                          column gap=10 testId="section-active"
                            text "ACTIVE" font-size="0.8125rem" font-weight=800
                            column gap=12
                              for x in experiments.filter(r => not r.complete) key=x.id
                                ExperimentCard(x=x)
                        if experiments.filter(x => x.complete).length > 0
                          column gap=10 testId="section-completed"
                            text "COMPLETED" font-size="0.8125rem" font-weight=800
                            column gap=12
                              for x in experiments.filter(r => r.complete) key=x.id
                                ExperimentCard(x=x)
                else
                  scroll id=`content-${e.id}` flex=1 min-height=0
                    column padding=20 gap=16 width="100%" box-sizing="border-box"
                      header appearance="none" display="flex" flex-direction="column" gap=8
                        row width="100%" align-items="center" flex-wrap="wrap" gap=12
                          text "Experimemo" role="heading" aria-level=1 font-family="Yellowtail" font-size="2rem" font-weight=400 line-height=1.6 flex=(wide ? "1 1 0" : "1 1 12rem") min-width=0 -exact-fit="shrink"
                          TopTabs(wide=wide, current="new", goNew=pickNew, goTrack=pickTrack)
                          row flex=(wide ? "1 1 0" : "0 0 auto") justify-content="flex-end"
                            link href="/info" aria-label="Open app info and settings" testId="info-new" min-width="2.5rem" min-height="2.5rem" padding="0.5rem" flex-shrink=0 border="1px solid var(--brand)" border-radius=999 background-color="surface.card" display="flex" align-items="center" justify-content="center"
                              image "symbol:info" font-size="1.375rem"
                        text "Create a new experiment plan now, then update observations, results, notes, and photos as it unfolds." font-size="0.9375rem" line-height="1.375rem"
                      column gap=12
                        column background-color="surface.card" border=(titleError == "" ? "1px solid var(--brand)" : "1px solid var(--warning)") border-radius=12 padding=16 gap=8
                          text "Experiment title" font-size="0.9375rem" font-weight=800
                          input value=title input=editTitle placeholder="Plant growth with indirect sunlight" aria-label="Experiment title" aria-invalid=(titleError != "") testId="field-title" background-color="surface.page" border-radius=14 padding="12px 14px" height=50
                          if titleError != ""
                            text titleError color="warning" font-size="0.8125rem" font-weight=700 testId="error-title"
                        column background-color="surface.card" border="1px solid var(--brand)" border-radius=12 padding=16 gap=8
                          text "Category" font-size="0.9375rem" font-weight=800
                          input value=category input=editCategory placeholder="Botany, Chemistry, Physics" aria-label="Category" testId="field-category" background-color="surface.page" border-radius=14 padding="12px 14px" height=50
                        column background-color="surface.card" border=(hypothesisError == "" ? "1px solid var(--brand)" : "1px solid var(--warning)") border-radius=12 padding=16 gap=8
                          text "Hypothesis" font-size="0.9375rem" font-weight=800
                          textarea value=hypothesis input=editHypothesis placeholder="What do you expect to happen?" aria-label="Hypothesis" aria-invalid=(hypothesisError != "") testId="field-hypothesis" rows=4 background-color="surface.page" border-radius=14 padding="12px 14px" height=112
                          if hypothesisError != ""
                            text hypothesisError color="warning" font-size="0.8125rem" font-weight=700 testId="error-hypothesis"
                        column background-color="surface.card" border=(procedureError == "" ? "1px solid var(--brand)" : "1px solid var(--warning)") border-radius=12 padding=16 gap=8
                          text "Procedure" font-size="0.9375rem" font-weight=800
                          textarea value=procedure input=editProcedure placeholder="List the setup, materials, and repeatable steps." aria-label="Procedure" aria-invalid=(procedureError != "") testId="field-procedure" rows=4 background-color="surface.page" border-radius=14 padding="12px 14px" height=112
                          if procedureError != ""
                            text procedureError color="warning" font-size="0.8125rem" font-weight=700 testId="error-procedure"
                        column background-color="surface.card" border="1px solid var(--brand)" border-radius=12 padding=16 gap=8
                          text "Data collection plan" font-size="0.9375rem" font-weight=800
                          textarea value=dataPlan input=editDataPlan placeholder="What measurements, photos, and observations will you capture?" aria-label="Data collection plan" testId="field-dataplan" rows=4 background-color="surface.page" border-radius=14 padding="12px 14px" height=112
                        column background-color="surface.card" border="1px solid var(--brand)" border-radius=12 padding=16 gap=8
                          text "Observations" font-size="0.9375rem" font-weight=800 -exact-fit="shrink"
                          textarea value=observations input=editObservations placeholder="You can leave this blank until you start recording observations." aria-label="Observations" testId="field-observations" rows=4 background-color="surface.page" border-radius=14 padding="12px 14px" height=112
                        column background-color="surface.card" border="1px solid var(--brand)" border-radius=12 padding=16 gap=8
                          text "Field notes" font-size="0.9375rem" font-weight=800
                          textarea value=fieldNotes input=editFieldNotes placeholder="Capture reminders, context, or setup details." aria-label="Field notes" testId="field-notes" rows=4 background-color="surface.page" border-radius=14 padding="12px 14px" height=112
                        column background-color="surface.card" border="1px solid var(--brand)" border-radius=12 padding=16 gap=8
                          text "Conclusion" font-size="0.9375rem" font-weight=800
                          textarea value=conclusion input=editConclusion placeholder="Summarize what the experiment shows when you are ready." aria-label="Conclusion" testId="field-conclusion" rows=4 background-color="surface.page" border-radius=14 padding="12px 14px" height=112
                        column background-color="surface.card" border="1px solid var(--brand)" border-radius=12 padding=16 gap=8
                          text "Planned photo count" font-size="0.9375rem" font-weight=800
                          input value=planned input=editPlanned inputmode="numeric" placeholder="0" aria-label="Planned photo count" testId="field-planned" background-color="surface.page" border-radius=14 padding="12px 14px" height=50
                      column background-color="surface.card" border="1px solid var(--brand)" border-radius=12 padding=16 gap=10
                        text "Photos" font-size="1.0625rem" font-weight=800
                        text "Add photos now or attach them later from the experiment record." font-size="0.875rem" line-height="1.25rem"
                        button press=askPhotos("new", "", "") disabled=photoBusy testId="new-add-photos" aria-label="Add photos" border="1px solid var(--brand)" border-radius=999 min-height="3rem" padding="0.5rem 1rem" align-self="flex-start"
                          text "Add photos" font-weight=800 font-size="0.875rem"
                        PhotoGrid(photos=newPhotos, prefix="new", remove=removeNewPhoto, busy=false)
                        if photoNoteKey == "new" and photoNote != ""
                          text photoNote color="warning" font-size="0.8125rem" line-height="1.25rem" font-weight=700 testId="new-photo-note" role="alert"
                      column background-color="surface.card" border="1px solid var(--brand)" border-radius=12 padding=16 gap=10
                        text "Save and continue later" font-size="1.0625rem" font-weight=800
                        text "Your experiment appears in Track right away so you can keep building it out whenever you need to." font-size="0.875rem" line-height="1.25rem"
                        button press=save disabled=(pending(created) or photoBusy or pending(camShot) or camOpen) testId="save" aria-label="Save experiment" background-color="secondary" color="ink.on-secondary" border-radius=999 min-height=48 font-weight=800 font-size="0.875rem"
                          text (pending(created) ? "Saving..." : "Save experiment")
                        if createError != ""
                          text createError color="warning" font-size="0.8125rem" font-weight=700 testId="create-error" role="alert"
      dialog id="photo-source" role="alertdialog" aria-label="Add photos" cancel=sourceCancelled
        text "Choose how to add experiment photos." testId="photo-source-text"
        button press=chooseCamera commandfor="photo-source" command="close" testId="photo-source-camera"
          text "Take Photo"
        button press=chooseLibrary commandfor="photo-source" command="close" testId="photo-source-library"
          text "Choose from Library"
        button commandfor="photo-source" command="close" testId="photo-source-cancel"
          text "Cancel"
      dialog id="camera-dialog" aria-label="Take a photo" cancel=cameraDismissed closedby="none"
        column gap=12 padding=16 width="100%" box-sizing="border-box"
          text "Take a photo" font-size="1.0625rem" font-weight=800
          if camOpenError != ""
            text camOpenError color="warning" font-size="0.875rem" line-height="1.25rem" font-weight=700 testId="camera-error" role="alert"
          else
            if camTrack == ""
              text "Opening the camera. Allow access if you are asked." font-size="0.875rem" testId="camera-opening"
            else
              exact-camera srcObject=camTrack object-fit="cover" width="100%" height=300 testId="viewfinder"
          if shotErrorShown != ""
            text shotErrorShown color="warning" font-size="0.875rem" line-height="1.25rem" font-weight=700 testId="camera-shot-error" role="alert"
          row gap=12 flex-wrap="wrap"
            button press=shutter disabled=(camTrack == "" or pending(camShot)) testId="camera-shutter" aria-label="Take photo" background-color="secondary" color="ink.on-secondary" border-radius=999 min-height=48 font-weight=800 font-size="0.875rem" padding="0.5rem 1rem"
              text (pending(camShot) ? "Saving..." : "Take photo")
            button press=closeCamera testId="camera-close" aria-label="Close camera" border="1px solid var(--brand)" border-radius=999 min-height=48 font-weight=800 font-size="0.875rem" padding="0.5rem 1rem"
              text "Close"
      input type="file" accept="image/*" multiple=true id="photo-picker" testId="photo-picker" display="none" change=photosPicked cancel=photosCancelled
      row role="tablist" display=(wide ? "none" : "flex")
        button role="tab" aria-controls="panel-new" aria-selected=(nav.tab == "new") press=pick("new") testId="tab-new" flex=1
          image "symbol:add"
          text "New"
        button role="tab" aria-controls="panel-track" aria-selected=(nav.tab == "track") press=pick("track") testId="tab-track" flex=1
          image "symbol:package"
          text "Track"
      dialog id="delete-confirm" role="alertdialog" aria-label="Delete experiment?"
        text `This will permanently remove "${aimedTitle}".` testId="delete-confirm-text"
        button press=confirmDelete destructive=true commandfor="delete-confirm" command="close" testId="delete-confirm-yes"
          text "Delete"
        button commandfor="delete-confirm" command="close" testId="delete-confirm-cancel"
          text "Cancel"
      dialog id="result-delete-confirm" role="alertdialog" aria-label="Delete result?"
        text "This will remove the result notes and photos from this record." testId="result-delete-text"
        button press=confirmDeleteResult destructive=true commandfor="result-delete-confirm" command="close" testId="result-delete-yes"
          text "Delete"
        button commandfor="result-delete-confirm" command="close" testId="result-delete-cancel"
          text "Cancel"
      dialog id="reset-confirm" role="alertdialog" aria-label="Reset app data?"
        text "This will permanently remove every experiment and leave the app empty." testId="reset-confirm-text"
        button press=confirmReset destructive=true commandfor="reset-confirm" command="close" testId="reset-confirm-yes"
          text "Reset"
        button commandfor="reset-confirm" command="close" testId="reset-confirm-cancel"
          text "Cancel"

component InfoRow
  props
    title: string
    body: string
    url: string
    testId: string
  action open
    openURL(url)
  view
    if url == ""
      column gap=2 testId=testId
        text title font-size="0.9375rem" font-weight=800
        text body font-size="0.875rem" line-height="1.25rem"
    else
      button press=open testId=testId aria-label=title display="flex" flex-wrap="wrap" align-items="center" gap=8 text-align="left" padding="0.25rem 0"
        column flex-grow=1 flex-basis="10rem" min-width=0 gap=2
          text title font-size="0.9375rem" font-weight=800
          text body font-size="0.875rem" line-height="1.25rem"
        text "Open" font-size="0.8125rem" font-weight=800 color="ink"

component ExperimentCard
  props
    x: Experiment
  view
    link href=path("experiment", x.id) testId=`card-${x.id}` aria-label=`${x.title}, ${x.badge}. Open experiment`
      column background-color="surface.card" border=(x.complete ? "1px solid var(--secondary)" : "1px solid var(--brand)") border-radius=12 padding=16 gap=10 width="100%" box-sizing="border-box"
        row gap=10 flex-wrap="wrap" align-items="flex-start"
          column flex-grow=1 flex-basis="10rem" min-width=0 gap=4
            text x.title font-size="1rem" font-weight=800
            text x.meta font-size="0.75rem" line-height="1.125rem"
          text x.badge testId=`badge-${x.id}` background-color=(x.complete ? "secondary" : "brand") color=(x.complete ? "ink.on-secondary" : "ink.on-brand") border-radius=999 padding="4px 10px" font-size="0.75rem" font-weight=800
        column gap=4
          text "Hypothesis" font-size="0.75rem" font-weight=800
          text x.hypothesis font-size="0.875rem" line-height="1.25rem"
          text "Observations" font-size="0.75rem" font-weight=800 -exact-fit="shrink"
          text x.observations font-size="0.875rem" line-height="1.25rem"
          text "Results" font-size="0.75rem" font-weight=800
          text x.results font-size="0.875rem" line-height="1.25rem" testId=`results-${x.id}`
        row gap=12 flex-wrap="wrap"
          text x.plannedLabel font-size="0.75rem" font-weight=700
          text x.conclusionLabel font-size="0.75rem" font-weight=700

component ExperimentEditor
  props
    route: number
    x: Experiment
    fieldDrafts: FieldDraft[]
    touch: action
    retry: action
    setStatus: action
    saveError: string
    savedId: string
    draft: string
    editDraft: action
    addResult: action
    adding: bool
    addError: string
    editResult: action
    retryResult: action
    resultDrafts: ResultDraft[]
    askDeleteResult: action
    removeResultError: string
    resultBusy: bool
    draftPhotos: Photo[]
    askPhotos: action
    removePhoto: action
    photoNote: string
    photoNoteKey: string
    photoBusy: bool
    hasPending: bool
    saving: bool
    statusBusy: bool
    statusError: string
  state title = match first(fieldDrafts.filter(d => d.id == x.id)) { case some(d) => d.title, case none => x.title }
  state category = match first(fieldDrafts.filter(d => d.id == x.id)) { case some(d) => d.category, case none => x.category }
  state hypothesis = match first(fieldDrafts.filter(d => d.id == x.id)) { case some(d) => d.hypothesis, case none => x.hypothesis }
  state procedure = match first(fieldDrafts.filter(d => d.id == x.id)) { case some(d) => d.procedure, case none => x.procedure }
  state dataPlan = match first(fieldDrafts.filter(d => d.id == x.id)) { case some(d) => d.dataPlan, case none => x.dataPlan }
  state observations = match first(fieldDrafts.filter(d => d.id == x.id)) { case some(d) => d.observations, case none => x.observationsText }
  state notes = match first(fieldDrafts.filter(d => d.id == x.id)) { case some(d) => d.notes, case none => x.notes }
  state conclusion = match first(fieldDrafts.filter(d => d.id == x.id)) { case some(d) => d.conclusion, case none => x.conclusion }
  state planned = match first(fieldDrafts.filter(d => d.id == x.id)) { case some(d) => `${d.planned}`, case none => `${x.planned}` }
  state titleError = ""
  state hypothesisError = ""
  derive invalid = title.trim() == "" or hypothesis.trim() == ""
  derive plannedNum = match parseNumber(planned) { case some(v) => (v < 0 ? 0 : round(v)), case none => 0 }
  derive fieldError = match first(fieldDrafts.filter(d => d.id == x.id and d.failed)) { case some(d) => d.error, case none => "" }
  derive saveFailed = fieldError != ""
  action editTitle(v: string)
    title = v
    titleError = (v.trim() == "" ? "Give this experiment a name." : "")
    touch(x.id, v, category, hypothesis, procedure, dataPlan, observations, notes, conclusion, plannedNum)
  action editCategory(v: string)
    category = v
    touch(x.id, title, v, hypothesis, procedure, dataPlan, observations, notes, conclusion, plannedNum)
  action editHypothesis(v: string)
    hypothesis = v
    hypothesisError = (v.trim() == "" ? "Capture the question or expectation you are testing." : "")
    touch(x.id, title, category, v, procedure, dataPlan, observations, notes, conclusion, plannedNum)
  action editProcedure(v: string)
    procedure = v
    touch(x.id, title, category, hypothesis, v, dataPlan, observations, notes, conclusion, plannedNum)
  action editDataPlan(v: string)
    dataPlan = v
    touch(x.id, title, category, hypothesis, procedure, v, observations, notes, conclusion, plannedNum)
  action editObservations(v: string)
    observations = v
    touch(x.id, title, category, hypothesis, procedure, dataPlan, v, notes, conclusion, plannedNum)
  action editNotes(v: string)
    notes = v
    touch(x.id, title, category, hypothesis, procedure, dataPlan, observations, v, conclusion, plannedNum)
  action editConclusion(v: string)
    conclusion = v
    touch(x.id, title, category, hypothesis, procedure, dataPlan, observations, notes, v, plannedNum)
  action addDraftPhotos
    askPhotos("draft", x.id, "")
  action dropDraftPhoto(photoId: string, uri: string)
    removePhoto("draft", x.id, "", photoId, uri)
  action addExpPhotos
    askPhotos("experiment", x.id, "")
  action dropExpPhoto(photoId: string, uri: string)
    removePhoto("experiment", x.id, "", photoId, uri)
  action addResultPhotos(resultId: string)
    askPhotos("result", x.id, resultId)
  action dropResultPhoto(resultId: string, photoId: string, uri: string)
    removePhoto("result", x.id, resultId, photoId, uri)
  action typeDraft(v: string)
    editDraft(x.id, v)
  action editPlanned(v: string)
    planned = v
    let n = match parseNumber(v) { case some(p) => (p < 0 ? 0 : round(p)), case none => 0 }
    touch(x.id, title, category, hypothesis, procedure, dataPlan, observations, notes, conclusion, n)
  view
    column flex=1 min-height=0 display="flex" flex-direction="column"
      scroll id=`content-${route}` flex=1 min-height=0
        column padding=20 gap=16 max-width="45rem" margin="0 auto" width="100%" box-sizing="border-box"
          column background-color="surface.card" border=(x.complete ? "1px solid var(--secondary)" : "1px solid var(--brand)") border-radius=12 padding=16 gap=10
            row gap=10 flex-wrap="wrap" align-items="center" justify-content="space-between"
              text x.badge testId="editor-status" role="status" background-color=(x.complete ? "secondary" : "brand") color=(x.complete ? "ink.on-secondary" : "ink.on-brand") border-radius=999 padding="4px 10px" font-size="0.75rem" font-weight=800
              button press=setStatus(x.id, (x.complete ? "active" : "complete")) disabled=statusBusy testId="toggle-status" border="1px solid var(--brand)" border-radius=999 min-height="3rem" padding="0.5rem 1rem" max-width="100%" box-sizing="border-box"
                text (x.complete ? "Mark active" : "Mark complete") font-weight=800 font-size="0.875rem" -exact-fit="shrink"
            text x.meta font-size="0.75rem" line-height="1.125rem" testId="editor-meta"
            if statusError != ""
              text statusError color="warning" font-size="0.8125rem" font-weight=700 testId="status-error" role="alert"
          column background-color="surface.card" border="1px solid var(--brand)" border-radius=12 padding=16 gap=8
            text "Observations" font-size="0.9375rem" font-weight=800 -exact-fit="shrink"
            textarea value=observations input=editObservations aria-label="Observations" testId="edit-observations" rows=4 background-color="surface.page" border-radius=14 padding="12px 14px" height=112
          column background-color="surface.card" border="1px solid var(--brand)" border-radius=12 padding=16 gap=8
            text "Field notes" font-size="0.9375rem" font-weight=800
            textarea value=notes input=editNotes aria-label="Field notes" testId="edit-notes" rows=4 background-color="surface.page" border-radius=14 padding="12px 14px" height=112
          column background-color="surface.card" border="1px solid var(--brand)" border-radius=12 padding=16 gap=8
            text "Conclusion" font-size="0.9375rem" font-weight=800
            textarea value=conclusion input=editConclusion aria-label="Conclusion" testId="edit-conclusion" rows=4 background-color="surface.page" border-radius=14 padding="12px 14px" height=112
          column background-color="surface.card" border="1px solid var(--brand)" border-radius=12 padding=16 gap=8
            text "Planned photo count" font-size="0.9375rem" font-weight=800
            input value=planned input=editPlanned inputmode="numeric" aria-label="Planned photo count" testId="edit-planned" background-color="surface.page" border-radius=14 padding="12px 14px" height=50
          column background-color="surface.card" border="1px solid var(--brand)" border-radius=12 padding=16 gap=10 testId="results-card"
            text "Results" role="heading" aria-level=3 font-size="1.0625rem" font-weight=800
            text x.entryCount font-size="0.8125rem" font-weight=700 testId="result-count"
            column gap=8
              text "New result" font-size="0.9375rem" font-weight=800
              textarea value=draft input=typeDraft aria-label="New result" testId="result-draft" rows=4 placeholder="Add result details." background-color="surface.page" border-radius=14 padding="12px 14px" height=112
              button press=addResult(x.id) disabled=(adding or (draft.trim() == "" and draftPhotos.length == 0)) testId="result-add" aria-label="Save result" background-color="secondary" color="ink.on-secondary" border-radius=999 min-height=48 font-weight=800 font-size="0.875rem" align-self="flex-start" padding="0.5rem 1rem"
                text (adding ? "Saving..." : "Save result")
              if addError != ""
                text addError color="warning" font-size="0.8125rem" line-height="1.25rem" font-weight=700 testId="result-add-error" role="alert"
              button press=addDraftPhotos disabled=photoBusy testId="draft-add-photos" aria-label="Add photos to the new result" border="1px solid var(--brand)" border-radius=999 min-height="3rem" padding="0.5rem 1rem" align-self="flex-start"
                text "Add photos" font-weight=800 font-size="0.875rem"
              PhotoGrid(photos=draftPhotos, prefix="draft", remove=dropDraftPhoto, busy=false)
              if photoNoteKey == `draft-${x.id}` and photoNote != ""
                text photoNote color="warning" font-size="0.8125rem" line-height="1.25rem" font-weight=700 testId="draft-photo-note" role="alert"
            if removeResultError != ""
              text removeResultError color="warning" font-size="0.8125rem" line-height="1.25rem" font-weight=700 testId="result-remove-error" role="alert"
            for r in x.entries key=r.id
              ResultEntry(expId=x.id, r=r, drafts=resultDrafts, edit=editResult, retry=retryResult, askDelete=askDeleteResult, busy=resultBusy, addPhotos=addResultPhotos, dropPhoto=dropResultPhoto, photoBusy=photoBusy, photoNote=(photoNoteKey == `result-${r.id}` ? photoNote : ""))
          column background-color="surface.card" border="1px solid var(--brand)" border-radius=12 padding=16 gap=10 testId="attached-photos"
            text "Attached photos" font-size="1.0625rem" font-weight=800
            text "Keep your reference photos with the experiment so everything stays easy to review later." font-size="0.875rem" line-height="1.25rem"
            button press=addExpPhotos disabled=photoBusy testId="exp-add-photos" aria-label="Add photos to the experiment" border="1px solid var(--brand)" border-radius=999 min-height="3rem" padding="0.5rem 1rem" align-self="flex-start"
              text "Add photos" font-weight=800 font-size="0.875rem"
            PhotoGrid(photos=x.photoList, prefix="exp", remove=dropExpPhoto, busy=photoBusy)
            if photoNoteKey == `exp-${x.id}` and photoNote != ""
              text photoNote color="warning" font-size="0.8125rem" line-height="1.25rem" font-weight=700 testId="exp-photo-note" role="alert"
          column background-color="surface.card" border="1px solid var(--brand)" border-radius=12 padding=16 gap=14 testId="experiment-details"
            column gap=6
              text "Experiment title" font-size="0.9375rem" font-weight=800
              input value=title input=editTitle aria-label="Experiment title" aria-invalid=(titleError != "") testId="edit-title" background-color="surface.page" border-radius=14 padding="12px 14px" height=44
              if titleError != ""
                text titleError color="warning" font-size="0.8125rem" font-weight=700 testId="edit-error-title"
            column gap=6
              text "Category" font-size="0.9375rem" font-weight=800
              input value=category input=editCategory aria-label="Category" testId="edit-category" background-color="surface.page" border-radius=14 padding="12px 14px" height=44
            column gap=6
              text "Hypothesis" font-size="0.9375rem" font-weight=800
              textarea value=hypothesis input=editHypothesis aria-label="Hypothesis" aria-invalid=(hypothesisError != "") testId="edit-hypothesis" rows=3 background-color="surface.page" border-radius=14 padding="12px 14px" height=88
              if hypothesisError != ""
                text hypothesisError color="warning" font-size="0.8125rem" font-weight=700 testId="edit-error-hypothesis"
            column gap=6
              text "Procedure" font-size="0.9375rem" font-weight=800
              textarea value=procedure input=editProcedure aria-label="Procedure" testId="edit-procedure" rows=3 background-color="surface.page" border-radius=14 padding="12px 14px" height=88
            column gap=6
              text "Data collection plan" font-size="0.9375rem" font-weight=800
              textarea value=dataPlan input=editDataPlan aria-label="Data collection plan" testId="edit-dataplan" rows=3 background-color="surface.page" border-radius=14 padding="12px 14px" height=88
          column gap=8 testId="autosave-status"
            text "Changes save automatically a moment after you stop typing. Result notes save the same way, and a new result is saved when you add it; photos are added and removed on their own, straight away." font-size="0.875rem" line-height="1.25rem"
            if hasPending or saving
              text "Saving…" font-size="0.8125rem" font-weight=700 testId="save-pending" role="status"
            else if invalid
              text "Not saved yet: a title and a hypothesis are required." color="warning" font-size="0.8125rem" line-height="1.25rem" font-weight=700 testId="save-invalid" role="status"
            else if saveFailed
              text `Not saved: ${fieldError}` color="warning" font-size="0.8125rem" line-height="1.25rem" font-weight=700 testId="save-error" role="alert"
              button press=retry(x.id) testId="retry-save" border="1px solid var(--brand)" border-radius=999 min-height="3rem" padding="0.5rem 1rem" align-self="flex-start" max-width="100%" box-sizing="border-box"
                text "Try saving again" font-weight=800 font-size="0.875rem" -exact-fit="shrink"
            else if savedId == x.id
              text "All changes saved." font-size="0.8125rem" font-weight=700 testId="save-ok" role="status"

component ResultEntry
  props
    expId: string
    r: ResultItem
    drafts: ResultDraft[]
    edit: action
    retry: action
    askDelete: action
    busy: bool
    addPhotos: action
    dropPhoto: action
    photoBusy: bool
    photoNote: string
  derive mine = drafts.filter(d => d.id == r.id)
  derive waiting = mine.length > 0
  derive text = match first(mine) { case some(d) => d.notes, case none => r.notes }
  derive failed = mine.filter(d => d.failed).length > 0
  derive error = match first(mine) { case some(d) => d.error, case none => "" }
  action type(v: string)
    edit(expId, r.id, v)
  action again
    retry(r.id)
  action add
    addPhotos(r.id)
  action drop(photoId: string, uri: string)
    dropPhoto(r.id, photoId, uri)
  view
    column background-color="surface.page" border-radius=12 padding=12 gap=8 testId=`result-${r.id}`
      row gap=8 flex-wrap="wrap" align-items="center" justify-content="space-between"
        text r.stamp font-size="0.8125rem" font-weight=800 testId=`result-stamp-${r.id}`
        button press=askDelete(expId, r.id) disabled=busy aria-label=`Delete result from ${r.stamp}` testId=`result-delete-${r.id}` background-color="danger" color="ink.on-danger" border-radius=999 min-width="2.5rem" min-height="2.5rem" padding="0.5rem" flex-shrink=0
          image "symbol:close"
      textarea value=text input=type aria-label=`Result notes, ${r.stamp}` testId=`result-notes-${r.id}` rows=3 placeholder="Add result details." background-color="surface.card" border-radius=14 padding="12px 14px" height=96
      PhotoGrid(photos=r.photoItems, prefix=`result-${r.id}`, remove=drop, busy=photoBusy)
      if r.photos > 0
        text `${r.photos} ${r.photos == 1 ? "photo" : "photos"} attached` font-size="0.8125rem" testId=`result-photos-${r.id}`
      button press=add disabled=photoBusy testId=`result-add-photos-${r.id}` aria-label="Add photos to this result" border="1px solid var(--brand)" border-radius=999 min-height="3rem" padding="0.5rem 1rem" align-self="flex-start"
        text "Add photos" font-weight=800 font-size="0.875rem"
      if photoNote != ""
        text photoNote color="warning" font-size="0.8125rem" line-height="1.25rem" font-weight=700 testId=`result-photo-note-${r.id}` role="alert"
      if failed
        text `Not saved: ${error}` color="warning" font-size="0.8125rem" line-height="1.25rem" font-weight=700 testId=`result-error-${r.id}` role="alert"
        button press=again testId=`result-retry-${r.id}` border="1px solid var(--brand)" border-radius=999 min-height="3rem" padding="0.5rem 1rem" align-self="flex-start"
          text "Try saving again" font-weight=800 font-size="0.875rem"
      else if waiting
        text "Saving…" font-size="0.8125rem" font-weight=700 testId=`result-saving-${r.id}` role="status"

// On a wide window the reference draws its tabs as pills across the top of the page; the bar
// below is then hidden, so each tab is reachable once.
component TopTabs
  props
    wide: bool
    current: string
    goNew: action
    goTrack: action
  view
    if wide
      row role="tablist" gap=8 flex-shrink=0
        button role="tab" aria-selected=(current == "new") press=goNew testId="tab-new" min-height="2.5rem" padding="0 1rem" border-radius=999 border=(current == "new" ? "1px solid var(--ink)" : "1px solid transparent") background-color=(current == "new" ? "surface.page" : "transparent") color=(current == "new" ? "brand" : "ink") font-weight=800 font-size="0.9375rem"
          text "New"
        button role="tab" aria-selected=(current == "track") press=goTrack testId="tab-track" min-height="2.5rem" padding="0 1rem" border-radius=999 border=(current == "track" ? "1px solid var(--ink)" : "1px solid transparent") background-color=(current == "track" ? "surface.page" : "transparent") color=(current == "track" ? "brand" : "ink") font-weight=800 font-size="0.9375rem"
          text "Track"

component PhotoGrid
  props
    photos: Photo[]
    prefix: string
    remove: action
    busy: bool
  view
    if photos.length > 0
      row gap=10 flex-wrap="wrap" testId=`photos-${prefix}`
        for p in photos key=p.id
          button press=remove(p.id, p.uri) disabled=busy aria-label=`Remove photo ${p.name}` testId=`photo-${p.id}` display="flex" flex-direction="column" align-items="center" gap=6 background-color="transparent" border-radius=12
            image p.uri width=84 height=84 object-fit="cover" border-radius=12 border="1px solid var(--brand)" aria-label=`Photo ${p.name}`
            text "Remove" font-size="0.75rem" font-weight=700
