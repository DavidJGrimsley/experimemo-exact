test "starts on New with the form"
  expect tree has "root"
  expect tree has "field-title"
  expect tree has "tab-new"

test "empty save shows the reference validation messages"
  tap "save"
  expect text "error-title" == "Give this experiment a name."
  expect text "error-hypothesis" == "Capture the question or expectation you are testing."
  expect text "error-procedure" == "Add the repeatable steps before saving."

test "Track shows both example cards"
  tap "tab-track"
  expect tree has "card-experiment-seed-1"
  expect tree has "card-experiment-seed-2"

test "app info lists About, Feedback and links, and says delete and reset are unavailable"
  tap "info-new"
  clock settle
  expect tree has "settings-unavailable"
  expect tree has "delete-experiments"
  expect tree has "reset-app"
  expect tree has "row-about"
  expect tree has "row-support"
  expect tree has "row-developer"
  expect tree has "open-website"
  expect tree has "row-feedback"
  expect tree has "row-github"
  expect tree has "row-terms"
  expect tree has "row-privacy"

test "app info opens from Track too"
  tap "tab-track"
  tap "info-track"
  clock settle
  expect tree has "row-privacy"

test "onboarding Continue needs both acceptances"
  at "/onboarding"
  expect tree has "continue-disabled"
  expect tree missing "continue"
  type "accept-privacy" "true"
  expect tree has "continue-disabled"
  type "accept-terms" "true"
  expect tree has "continue"
  tap "continue"
  clock settle
  expect tree has "open-experiments"
  tap "open-experiments"
  clock settle
  expect tree has "field-title"

test "an unknown path shows not-found and Go home returns to New"
  at "/nowhere"
  expect tree has "notfound"
  tap "go-home"
  clock settle
  expect tree has "field-title"
