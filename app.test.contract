test "a wide window draws the reference's top tabs on New and Track and switches between them"
  size 1133x700
  expect tree has "tab-track"
  expect tree has "field-title"
  tap "tab-track"
  clock data
  expect tree has "section-active"
  expect tree has "tab-new"
  tap "tab-new"
  clock settle
  expect tree has "field-title"

test "an experiment photo is picked, previewed, kept after a reload, and removed for good"
  at "/experiment/experiment-seed-2"
  clock data
  tap "exp-add-photos"
  tap "photo-source-library"
  pick "photo-picker" "fixtures/sample.png"
  clock data
  clock settle
  expect tree has "photo-photo-1767225600000-1-0"
  expect tree missing "exp-photo-note"
  reload
  tap "tab-track"
  clock data
  tap "card-experiment-seed-2"
  clock settle
  expect tree has "photo-photo-1767225600000-1-0"
  tap "photo-photo-1767225600000-1-0"
  clock data
  clock settle
  expect tree missing "photo-photo-1767225600000-1-0"
  reload
  tap "tab-track"
  clock data
  tap "card-experiment-seed-2"
  clock settle
  expect tree missing "photo-photo-1767225600000-1-0"

test "photos on an experiment, a result and a result draft stay separate"
  at "/experiment/experiment-seed-1"
  clock data
  tap "exp-add-photos"
  tap "photo-source-library"
  pick "photo-picker" "fixtures/sample.png"
  clock data
  tap "result-add-photos-result-seed-1"
  tap "photo-source-library"
  pick "photo-picker" "fixtures/sample.png"
  clock data
  expect tree has "photo-photo-1767225600000-1-0"
  expect text "result-photos-result-seed-1" == "1 photo attached"
  tap "photo-photo-1767225600000-1-0"
  clock data
  clock settle
  expect tree missing "photo-photo-1767225600000-1-0"
  expect text "result-photos-result-seed-1" == "1 photo attached"
  reload
  tap "tab-track"
  clock data
  tap "card-experiment-seed-1"
  clock settle
  expect text "result-photos-result-seed-1" == "1 photo attached"
  expect tree missing "photo-photo-1767225600000-1-0"

test "a photo only result is saved from the draft and its last photo cannot be removed"
  at "/experiment/experiment-seed-2"
  clock data
  tap "draft-add-photos"
  tap "photo-source-library"
  pick "photo-picker" "fixtures/sample.png"
  clock data
  clock settle
