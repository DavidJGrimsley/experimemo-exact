test "New keeps picked photos with the saved record, and a removed one is not saved"
  tap "new-add-photos"
  tap "photo-source-library"
  pick "photo-picker" "fixtures/sample.png"
  clock data
  clock settle
  expect tree has "photos-new"
  tap "new-add-photos"
  tap "photo-source-library"
  pick "photo-picker" "fixtures/sample.png"
  clock data
  clock settle
  tap "photo-photo-1767225600000-1-0"
  clock data
  clock settle
  type "field-title" "With photo"
  type "field-hypothesis" "A hypothesis"
  type "field-procedure" "Steps"
  tap "save"
  clock data
  clock settle
  expect tree missing "photos-new"
  tap "With photo"
  clock settle
  expect tree has "photos-exp"
  expect tree missing "photo-photo-1767225600000-1-0"
  reload
  tap "tab-track"
  clock data
  tap "With photo"
  clock settle
  expect tree has "photos-exp"

test "a photo change leaves the other fields and a waiting autosave alone"
