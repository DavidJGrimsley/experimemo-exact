  tap "result-add"
  clock data
  clock settle
  expect text "result-count" == "1 timestamped entry"
  expect tree missing "photos-draft"
  tap "photo-photo-1767225600000-1-0"
  clock data
  clock settle
  expect tree has "photo-photo-1767225600000-1-0"
  reload
  tap "tab-track"
  clock data
  tap "card-experiment-seed-2"
  clock settle
  expect text "result-count" == "1 timestamped entry"
  expect tree has "photo-photo-1767225600000-1-0"

test "cancelling the picker says so and changes nothing"
