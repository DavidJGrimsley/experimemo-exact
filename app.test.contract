  tap "photo-source-cancel"
  clock settle
  expect text "result-draft" == ""
  back
  clock settle
  tap "card-experiment-seed-2"
  clock settle
  expect text "result-draft" == "Only for cooling"

test "deleting an experiment with a staged draft photo leaves the other experiment's draft alone"
  at "/experiment/experiment-seed-1"
  clock data
  tap "draft-add-photos"
  tap "photo-source-library"
  pick "photo-picker" "fixtures/sample.png"
  clock data
  clock settle
