  type "result-draft" "Kept"
  back
  clock settle
  tap "info-track"
  clock settle
  tap "delete-experiments"
  clock settle
  tap "delete-experiment-seed-1"
  clock settle
  tap "delete-confirm-yes"
  clock data
  clock settle
  expect state experiments.length == 1
  expect state draftPhotoSets == []
  tap "tab-track"
  clock settle
  tap "card-experiment-seed-2"
  clock settle
  expect text "result-draft" == "Kept"
  expect tree missing "photos-draft"
