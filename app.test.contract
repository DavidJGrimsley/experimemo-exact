test "starts on New with the form"
  expect tree has "root"
  expect tree has "field-title"
  expect tree has "tab-new"

test "empty save shows the reference validation messages"
  tap "save"
  expect text "error-title" == "Give this experiment a name."
  expect text "error-hypothesis" == "Capture the question or expectation you are testing."
  expect text "error-procedure" == "Add the repeatable steps before saving."

test "Track lists both seeded examples, newest update first, from the stored file"
  tap "tab-track"
  clock data
  expect tree has "section-active"
  expect tree missing "section-completed"
  expect tree has "card-experiment-seed-1"
  expect tree has "card-experiment-seed-2"
  expect text "badge-experiment-seed-1" == "ACTIVE"

test "a card opens its own record"
  tap "tab-track"
  clock data
  tap "card-experiment-seed-2"
  clock settle
  expect text "editor-title" == "Cooling rate of metal versus glass containers (Example)"
  expect text "edit-category" == "Physics"
  expect text "edit-planned" == "0"

test "a deep link opens the record, and a missing id says so"
  at "/experiment/experiment-seed-1"
  clock data
  expect text "editor-title" == "Bean sprouts under different light conditions (Example)"

test "a missing experiment shows its own screen with a way back"
  at "/experiment/nope"
  clock data
  expect tree has "editor-missing"
  tap "editor-missing-track"
  clock settle
  expect tree has "card-experiment-seed-1"

test "New saves a record, clears the form, opens Track, and the record survives a reload"
  type "field-title" "Mold growth on bread"
  type "field-hypothesis" "Bread in a damp bag molds first."
  type "field-procedure" "Seal slices in bags, one damp, one dry; photograph daily."
  tap "save"
  clock data
  expect state nav.tab == "track"
  expect text "field-title" == ""
  expect state experiments.length == 3
  reload
  tap "tab-track"
  clock data
  expect state experiments.length == 3
  tap "Mold growth on bread"
  clock settle
  expect text "editor-title" == "Mold growth on bread"
  expect text "edit-category" == "General"

test "an invalid New save stores nothing and keeps what was typed"
  type "field-title" "Half done"
  tap "save"
  expect text "error-hypothesis" == "Capture the question or expectation you are testing."
  expect text "field-title" == "Half done"
  tap "tab-track"
  clock data
  expect state experiments.length == 2

test "opening the editor saves nothing, even after waiting"
  tap "tab-track"
  clock data
  tap "card-experiment-seed-2"
  clock settle
  clock +5000
  clock data
  expect tree missing "save-pending"
  expect tree missing "save-ok"
  expect text "editor-meta" == "Physics - Updated Jun 15, 2026"

test "edits autosave 600 ms after the last one, each edit restarts the wait, and the result survives a reload"
  tap "tab-track"
  clock data
  tap "card-experiment-seed-2"
  clock settle
  type "edit-title" "Cooling rate, retitled"
  clock +400
  type "edit-observations" "Second run started."
  clock +400
  expect tree has "save-pending"
  expect tree missing "save-ok"
  clock +300
  clock data
  expect tree has "save-ok"
  expect tree missing "save-pending"
  reload
  tap "tab-track"
  clock data
  tap "card-experiment-seed-2"
  clock settle
  expect text "editor-title" == "Cooling rate, retitled"
  expect text "edit-observations" == "Second run started."

test "an invalid draft is never saved, keeps what was typed, and the stored record is unchanged"
  at "/experiment/experiment-seed-1"
  clock data
  type "edit-title" ""
  clock +2000
  clock data
  expect tree has "save-invalid"
  expect tree has "edit-error-title"
  expect tree missing "save-ok"
  expect text "edit-title" == ""
  reload
  tap "tab-track"
  clock data
  tap "card-experiment-seed-1"
  clock settle
  expect text "editor-title" == "Bean sprouts under different light conditions (Example)"

test "a valid edit after an invalid one saves"
  at "/experiment/experiment-seed-1"
  clock data
  type "edit-title" ""
  clock +1000
  type "edit-title" "Bean sprouts, renamed"
  clock +700
  clock data
  expect tree has "save-ok"
  expect text "editor-title" == "Bean sprouts, renamed"

test "a status change made while an edit waits is immediate and both survive a reload"
  at "/experiment/experiment-seed-1"
  clock data
  type "edit-title" "Edited then completed"
  tap "toggle-status"
  clock data
  expect text "editor-status" == "COMPLETE"
  expect tree has "save-pending"
  clock +700
  clock data
  expect tree has "save-ok"
  expect text "editor-status" == "COMPLETE"
  reload
  tap "tab-track"
  clock data
  expect text "badge-experiment-seed-1" == "COMPLETE"
  tap "card-experiment-seed-1"
  clock settle
  expect text "editor-title" == "Edited then completed"
  expect text "editor-status" == "COMPLETE"

test "a status change that lands while an autosave is in flight keeps both changes"
  at "/experiment/experiment-seed-1"
  clock data
  type "edit-title" "In flight"
  clock +600
  tap "toggle-status"
  clock data
  clock data
  expect text "editor-status" == "COMPLETE"
  expect tree has "save-ok"
  reload
  tap "tab-track"
  clock data
  expect text "badge-experiment-seed-1" == "COMPLETE"
  tap "card-experiment-seed-1"
  clock settle
  expect text "editor-title" == "In flight"

test "a status change followed by an edit before the first reply keeps both"
  at "/experiment/experiment-seed-2"
  clock data
  tap "toggle-status"
  type "edit-category" "Thermodynamics"
  clock +600
  clock data
  clock data
  reload
  tap "tab-track"
  clock data
  expect text "badge-experiment-seed-2" == "COMPLETE"
  tap "card-experiment-seed-2"
  clock settle
  expect text "edit-category" == "Thermodynamics"

test "an autosave waiting while another record is deleted still lands, and the delete holds"
  tap "tab-track"
  clock data
  tap "card-experiment-seed-1"
  clock settle
  type "edit-title" "Edited before delete"
  back
  clock settle
  tap "info-track"
  clock settle
  tap "delete-experiments"
  clock settle
  tap "delete-experiment-seed-2"
  clock settle
  tap "delete-confirm-yes"
  clock +700
  clock data
  clock data
  reload
  tap "tab-track"
  clock data
  expect state experiments.length == 1
  tap "card-experiment-seed-1"
  clock settle
  expect text "editor-title" == "Edited before delete"

test "an autosave waiting while a new record is created keeps the edit and the new record"
  tap "tab-track"
  clock data
  tap "card-experiment-seed-1"
  clock settle
  type "edit-title" "Edited during create"
  tap "tab-new"
  type "field-title" "Created meanwhile"
  type "field-hypothesis" "Both stay."
  type "field-procedure" "Save both."
  tap "save"
  clock +700
  clock data
  clock data
  reload
  tap "tab-track"
  clock data
  expect state experiments.length == 3
  tap "Created meanwhile"
  clock settle
  expect text "editor-title" == "Created meanwhile"

test "marking complete moves the card to COMPLETED and persists"
  at "/experiment/experiment-seed-1"
  clock data
  tap "toggle-status"
  clock data
  expect text "editor-status" == "COMPLETE"
  tap "tab-track"
  clock settle
  reload
  tap "tab-track"
  clock data
  expect tree has "section-completed"
  expect text "badge-experiment-seed-1" == "COMPLETE"
  expect tree has "section-active"

test "marking a completed record active returns it to ACTIVE"
  at "/experiment/experiment-seed-1"
  clock data
  tap "toggle-status"
  clock data
  tap "toggle-status"
  clock data
  expect text "editor-status" == "ACTIVE"

test "app info lists Settings, About, Feedback and the support, terms and privacy links"
  tap "info-new"
  clock settle
  expect tree has "delete-experiments"
  expect tree has "reset-app"
  expect tree has "row-about"
  expect tree has "row-support"
  expect tree has "row-developer"
  expect tree has "open-website"
  expect tree has "row-feedback"
  expect tree has "row-github"
  expect tree has "row-terms"
  expect tree has "row-privacy"

test "app info opens from Track too"
  tap "tab-track"
  clock data
  tap "info-track"
  clock settle
  expect tree has "row-privacy"

test "onboarding Continue needs both acceptances"
  at "/onboarding"
  expect tree has "continue-disabled"
  expect tree missing "continue"
  type "accept-privacy" "true"
  expect tree has "continue-disabled"
  type "accept-terms" "true"
  expect tree has "continue"
  tap "continue"
  clock settle
  expect tree has "open-experiments"
  tap "open-experiments"
  clock settle
  expect tree has "field-title"

test "an unknown path shows not-found and Go home returns to New"
  at "/nowhere"
  expect tree has "notfound"
  tap "go-home"
  clock settle
  expect tree has "field-title"

test "Delete experiments lists both examples and Done returns to App info"
  tap "info-new"
  clock settle
  tap "delete-experiments"
  clock settle
  expect tree has "delete-row-experiment-seed-1"
  expect tree has "delete-row-experiment-seed-2"
  tap "delete-done"
  clock settle
  expect tree has "reset-app"

test "cancelling a delete keeps the record"
  tap "info-new"
  clock settle
  tap "delete-experiments"
  clock settle
  tap "delete-experiment-seed-1"
  clock settle
  expect text "delete-confirm-text" == "This will permanently remove \"Bean sprouts under different light conditions (Example)\"."
  tap "delete-confirm-cancel"
  clock settle
  expect state experiments.length == 2
  expect tree has "delete-row-experiment-seed-1"

test "a confirmed delete removes only that record and the example stays gone after reload"
  tap "info-new"
  clock settle
  tap "delete-experiments"
  clock settle
  tap "delete-experiment-seed-1"
  clock settle
  tap "delete-confirm-yes"
  clock data
  expect state experiments.length == 1
  expect tree missing "delete-row-experiment-seed-1"
  expect tree has "delete-row-experiment-seed-2"
  reload
  tap "tab-track"
  clock data
  expect state experiments.length == 1
  expect tree missing "card-experiment-seed-1"
  expect tree has "card-experiment-seed-2"

test "deleting every record shows the empty list and an empty Track that survives reload"
  tap "info-new"
  clock settle
  tap "delete-experiments"
  clock settle
  tap "delete-experiment-seed-1"
  clock settle
  tap "delete-confirm-yes"
  clock data
  tap "delete-experiment-seed-2"
  clock settle
  tap "delete-confirm-yes"
  clock data
  expect tree has "delete-empty"
  reload
  tap "tab-track"
  clock data
  expect tree has "track-empty"
  expect state experiments.length == 0

test "cancelling Reset leaves the records and stays in App info"
  tap "info-new"
  clock settle
  tap "reset-app"
  clock settle
  expect text "reset-confirm-text" == "This will permanently remove every experiment and leave the app empty."
  tap "reset-confirm-cancel"
  clock settle
  expect state experiments.length == 2
  expect tree has "reset-app"
  expect tree missing "reset-error"

test "Reset empties the app, returns to an empty Track, and the examples do not return after reload"
  tap "info-new"
  clock settle
  tap "reset-app"
  clock settle
  tap "reset-confirm-yes"
  clock data
  clock settle
  expect state nav.tab == "track"
  expect tree has "track-empty"
  expect state experiments.length == 0
  reload
  tap "tab-track"
  clock data
  expect tree has "track-empty"
  expect state experiments.length == 0

test "Reset from App info opened on Track also lands on an empty Track root"
  tap "tab-track"
  clock data
  tap "info-track"
  clock settle
  tap "reset-app"
  clock settle
  tap "reset-confirm-yes"
  clock data
  clock settle
  expect tree has "track-empty"
  expect tree missing "reset-app"

test "after Reset a new record is saved on its own and the examples stay gone"
  tap "info-new"
  clock settle
  tap "reset-app"
  clock settle
  tap "reset-confirm-yes"
  clock data
  clock settle
  tap "create-experiment"
  clock settle
  type "field-title" "After reset"
  type "field-hypothesis" "Only this remains."
  type "field-procedure" "Save it."
  tap "save"
  clock data
  expect state experiments.length == 1
  reload
  tap "tab-track"
  clock data
  expect state experiments.length == 1
  expect tree missing "card-experiment-seed-1"
