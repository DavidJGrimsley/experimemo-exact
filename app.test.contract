  reload
  tap "tab-track"
  clock data
  tap "card-experiment-seed-1"
  clock settle
  expect text "result-count" == "0 timestamped entries"

test "cancelling a result delete keeps the entry"
  at "/experiment/experiment-seed-1"
  clock data
  tap "result-delete-result-seed-1"
  clock settle
  expect text "result-delete-text" == "This will remove the result notes and photos from this record."
  tap "result-delete-cancel"
